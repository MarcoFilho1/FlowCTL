{
  "name": "@flowctl/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@flowctl/protocol": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:protocol": "pnpm --filter @flowctl/protocol build",
    "prebuild": "pnpm run prepare:protocol",
    "pretypecheck": "pnpm run prepare:protocol",
    "prebuild:test": "pnpm run prepare:protocol",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test dist-test/test/*.test.js"
  }
}
