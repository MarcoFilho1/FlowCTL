{
  "name": "flowctl",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "typecheck": "tsc -p mod && tsc -p tests",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"tests/**/*.test.ts\"",
    "validate": "claude plugin validate mod && claude plugin test mod",
    "viewer:dev": "pnpm --filter @flowctl/viewer dev",
    "viewer:test": "pnpm --filter @flowctl/viewer test",
    "viewer:build": "pnpm --filter @flowctl/viewer build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
