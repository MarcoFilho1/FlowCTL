{
  "name": "@flowctl/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:flowctl": "pnpm --filter @flowctl/control-plane build",
    "predev": "pnpm run prepare:flowctl",
    "dev": "vite",
    "pretest": "pnpm run prepare:flowctl",
    "test": "vitest run",
    "pretypecheck": "pnpm run prepare:flowctl",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm run prepare:flowctl",
    "build": "tsc -p tsconfig.json --noEmit && vite build"
  },
  "dependencies": {
    "@flowctl/control-plane": "workspace:*",
    "@flowctl/protocol": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
